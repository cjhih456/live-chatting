{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "scheme": "lumen",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lumen.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FB"
      },
      "package": "app.lumen.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
